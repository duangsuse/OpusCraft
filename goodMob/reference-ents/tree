model
size = 10 10 10
scale    = 0.1 0.12 0.1
origin   = -y
clamp = -y
skip = -y

// Rotate the folliage for a more stylish tree
rotatey = 180 180 0

// Light top and dark bottom foliage with fade for added contrast
// Warp the foliage, regenerate gives a different looking tree every time
material lighting = quad, roughness = 1, deform =  2, scatter = 0.2, warp = 1 0.2, fade = true
  colors = L:#060 M:#0A0 
  
// The trunk with a darker shadow at the top
material lighting = flat, roughness = 1, deform =  2, scatter = 0.15, fade = true
  colors = T:#A20 U:#400

